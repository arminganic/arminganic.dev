---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Armin Ganic">
  <div class="hero">
    <span>Hi, my name is</span>
    <h1>Armin Ganic</h1>
  </div>
</Layout>

<style>
  .hero {
    text-align: center;
    max-width: 800px;
    margin: 4rem auto;
    padding: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #222;
  }

  .tagline {
    font-size: 1.25rem;
    color: #666;
    margin-bottom: 2rem;
    font-weight: 300;
  }
</style>
