---
import Layout from '../layouts/Layout.astro';

const gravatar = {
  baseUrl: 'https://gravatar.com/avatar',
  hash: '42eb8a23795977bb28dd147781e05ca2cf30c08b4fd387a12ab64411fe3b835d',
  size: '1024',
};

function buildGravatar(): string {
  const { baseUrl, hash, size } = gravatar;
  return `${baseUrl}/${hash}?s=${size}`;
}

const gravatarUrl = buildGravatar();
---

<Layout title="Armin Ganic">
  <div class="hero">
    <img class="image" src={gravatarUrl} alt="">
    <span>Hi, my name is</span>
    <h1 class="heading">Armin Ganic</h1>
  </div>
</Layout>

<style>
  .hero {
    align-items: center;
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    max-width: 800px;
    padding-block: 4rem;
    padding-inline: 16px;
  }

  .image {
    border-radius: 9999px;
    margin-block-end: 24px;
    max-width: 200px;
    transition: scale 150ms ease-in-out;
  }

  @media (hover: hover) {
    .image:hover {
      scale: 1.025;
    }
  }
  
  .heading {
    font-size: 2.5rem;
    color: #222;
  }
</style>
