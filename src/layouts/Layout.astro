---
import '../styles/global.css';
import Button from '../components/Button.astro';
import ImprintModal, { IMPRINT_MODAL_ID } from '../components/modals/ImprintModal.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main class="main">
      <slot />
    </main>
    <footer class="footer">
      <section class="container">
        <p>© 2026 Armin Ganic. All rights reserved.</p>
        <Button
          id="btn-imprint"
          label="Impressum"
          command="show-modal"
          commandfor={IMPRINT_MODAL_ID}
        />
        <ImprintModal />
      </section>
    </footer>
  </body>
</html>

<style>
  .main {
    min-height: 100vh;
    padding-inline: 1rem;
  }

  .footer {
    background-color: black;
    padding-block: 2rem;
    padding-inline: 1rem;
  }
</style>
