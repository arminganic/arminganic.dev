---
import '../styles/global.css';
import '../styles/modal.css';
import { IMPRINT_MODAL_ID } from '../constants/modals';
import Button from '../components/Button.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main class="main">
      <slot />
    </main>
    <footer class="footer">
      <section class="container">
        <p>© 2026 Armin Ganic. All rights reserved.</p>
        <Button id="btn-imprint" aria={{ haspopup: 'dialog' }} label="Impressum" />
      </section>
    </footer>
  </body>
</html>

<script define:vars={{ IMPRINT_MODAL_ID }}>
  const button = document.getElementById('btn-imprint');
  if (button) {
    const memoizePromise = (fn) => {
      let promise;
      return () => {
        if (!promise)
          promise = fn().catch((error) => {
            promise = undefined;
            throw error;
          });
        return promise;
      };
    };

    const loadModal = memoizePromise(async () => {
      button.dataset.loading = 'true';
      try {
        const response = await fetch('/api/imprint-modal');
        if (!response.ok) {
          throw new Error('Failed to open the imprint modal.');
        }
        const html = await response.text();
        button.insertAdjacentHTML('afterend', html);
      } finally {
        button.dataset.loading = 'false';
      }
    });

    button.addEventListener('click', async () => {
      try {
        await loadModal();
      } catch (error) {
        console.error(error);
        return;
      }
      document.getElementById(IMPRINT_MODAL_ID)?.showModal();
    });
  }
</script>

<style>
  .main {
    min-height: 100vh;
    padding-inline: 1rem;
  }

  .footer {
    background-color: black;
    padding-block: 2rem;
    padding-inline: 1rem;
  }
</style>
