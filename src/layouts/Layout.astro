---
import '../styles/anchor.css';
import '../styles/button.css';
import '../styles/global.css';
import '../styles/modal.css';
import { IMPRINT_MODAL_ID } from '../constants/modals';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <main class="main">
      <slot />
    </main>
    <footer class="footer">
      <section class="footer-content container">
        <div class="footer-legal">
          <p>© 2026 Armin Ganic. All rights reserved.</p>
          <button id="btn-imprint" aria-haspopup="dialog" data-loading="false" data-variant="anchor"
            >Impressum</button
          >
        </div>
        <div class="footer-social">
          <!-- GitHub -->
          <a href="https://github.com/arminganic" target="_blank">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
              <path
                d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"
              ></path>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/in/arminganic/" target="_blank">
            <svg viewBox="0 0 34 34" width="32" height="32" fill="currentColor">
              <path
                d="M34 2.5v29a2.5 2.5 0 0 1-2.5 2.5h-29A2.5 2.5 0 0 1 0 31.5v-29A2.5 2.5 0 0 1 2.5 0h29A2.5 2.5 0 0 1 34 2.5M10 13H5v16h5zm.45-5.5a2.88 2.88 0 0 0-2.86-2.9H7.5a2.9 2.9 0 0 0 0 5.8 2.88 2.88 0 0 0 2.95-2.81zM29 19.28c0-4.81-3.06-6.68-6.1-6.68a5.7 5.7 0 0 0-5.06 2.58h-.14V13H13v16h5v-8.51a3.32 3.32 0 0 1 3-3.58h.19c1.59 0 2.77 1 2.77 3.52V29h5z"
              ></path>
              <path
                d="M34 2.5v29a2.5 2.5 0 0 1-2.5 2.5h-29A2.5 2.5 0 0 1 0 31.5v-29A2.5 2.5 0 0 1 2.5 0h29A2.5 2.5 0 0 1 34 2.5M10 13H5v16h5zm.45-5.5a2.88 2.88 0 0 0-2.86-2.9H7.5a2.9 2.9 0 0 0 0 5.8 2.88 2.88 0 0 0 2.95-2.81zM29 19.28c0-4.81-3.06-6.68-6.1-6.68a5.7 5.7 0 0 0-5.06 2.58h-.14V13H13v16h5v-8.51a3.32 3.32 0 0 1 3-3.58h.19c1.59 0 2.77 1 2.77 3.52V29h5z"
              ></path>
            </svg>
          </a>
        </div>
      </section>
    </footer>
  </body>
</html>

<script define:vars={{ IMPRINT_MODAL_ID }}>
  const button = document.getElementById('btn-imprint');
  if (button) {
    const memoizePromise = (fn) => {
      let promise;
      return () => {
        if (!promise)
          promise = fn().catch((error) => {
            promise = undefined;
            throw error;
          });
        return promise;
      };
    };

    const loadModal = memoizePromise(async () => {
      button.dataset.loading = 'true';
      try {
        const response = await fetch('/api/imprint-modal');
        if (!response.ok) {
          throw new Error('Failed to open the imprint modal.');
        }
        const html = await response.text();
        button.insertAdjacentHTML('afterend', html);
      } finally {
        button.dataset.loading = 'false';
      }
    });

    button.addEventListener('click', async () => {
      try {
        await loadModal();
      } catch (error) {
        console.error(error);
        return;
      }
      document.getElementById(IMPRINT_MODAL_ID)?.showModal();
    });
  }
</script>

<style>
  .main {
    min-height: 95vh;
    padding-inline: 1rem;
  }

  .footer {
    background-color: black;
    color: white;
    padding-block: 4rem;
    padding-inline: 1rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-legal {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-social {
    --anchor-color: var(--pf-color-white-100);
    display: flex;
    gap: 1rem;
  }

  #btn-imprint {
    --button-color: var(--pf-color-white-100);
  }

  @media screen and (width >= 700px) {
    .main {
      padding-inline: 2rem;
    }

    .footer {
      padding-block: 6rem;
      padding-inline: 2rem;
    }

    .footer-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
