---
import type { JSX } from 'astro/jsx-runtime';

interface AriaAttributes {
  haspopup?: JSX.AriaAttributes['aria-haspopup'];
}

interface Props {
  id: string;
  aria?: AriaAttributes;
  command?: string;
  commandfor?: string;
  label: string;
}

const { id, aria, command, commandfor, label } = Astro.props;
---

<button
  id={id}
  class="button"
  aria-haspopup={aria?.haspopup}
  command={command}
  commandfor={commandfor}
  data-loading="false"
>
  {label}
</button>

<style>
  .button[data-loading='true'] {
    cursor: progress;
    opacity: 0.6;
  }
</style>
