---
interface Props {
  id: string;
  label: string;
  command?: string;
  commandfor?: string;
}

const { id, label, command, commandfor: commandFor } = Astro.props;
---

<button id={id} class="button" command={command} commandfor={commandFor}>{label}</button>

<style>
  .button {
    background-color: transparent;
    border: none;
    color: var(--color);
    font-size: 1rem;
  }
</style>
