---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<dialog class="modal" id={id}>
  <header class="modal-header">
    <h1>{title}</h1>
    <button commandfor={id} command="close">Schließen</button>
  </header>
  <section class="modal-body">
    <slot />
  </section>
</dialog>

<style>
  .modal {
    --modal-margin-block-start: 4rem;
    --modal-border-radius: 12px;
    background-color: var(--background-color);
    border-start-end-radius: var(--modal-border-radius);
    border-start-start-radius: var(--modal-border-radius);
    border: none;
    color: white;
    inset: auto 0 0 0;
    margin-block-start: var(--modal-margin-block-start);
    max-height: calc(100vh - var(--modal-margin-block-start));
    max-width: unset;
    width: 100%;
  }

  .modal::backdrop {
    backdrop-filter: blur(2px);
    background-color: var(--backdrop-color);
  }

  .modal-header {
    align-items: center;
    border-block-end: 1px solid var(--backdrop-color);
    display: flex;
    padding: 1rem;
    justify-content: space-between;
  }

  .modal-body {
    padding: 1rem;
  }

  @media screen and (width >= 700px) {
    .modal {
      border-radius: var(--modal-border-radius);
      inset-block: 0;
      inset-inline: 1rem;
      margin: auto;
      max-width: 600px;
    }
  }
</style>
